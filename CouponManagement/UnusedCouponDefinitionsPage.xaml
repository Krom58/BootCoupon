<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CouponManagement.UnusedCouponDefinitionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CouponManagement"
    xmlns:services="using:CouponManagement.Shared.Services"
    xmlns:models="using:CouponManagement.Shared.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="DestructiveButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- InfoBar -->
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Tab Selection -->
            <RowDefinition Height="*"/>    <!-- Content Container -->
        </Grid.RowDefinitions>

        <!-- Status InfoBar -->
        <InfoBar x:Name="StatusInfoBar"
                 Grid.Row="0"
                 IsOpen="False"
                 Margin="12,8,12,0"/>

        <!-- Header -->
        <Border Grid.Row="1" Background="{ThemeResource SystemAccentColor}" Padding="20,16" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Back button -->
                <Button x:Name="BackButton"
                        Grid.Column="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="BackButton_Click"
                        ToolTipService.ToolTip="กลับไปยังเมนูหลัก"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                    <Border BorderBrush="White" BorderThickness="1" Background="#30FFFFFF" CornerRadius="8" Padding="8">
                        <SymbolIcon Symbol="Back" Foreground="White"/>
                    </Border>
                </Button>

                <!-- Title & Subtitle -->
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="ลบคำนิยามคูปองที่หมดอายุ / ไม่ได้ใช้งาน" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="White"/>
                    <TextBlock Text="ค้นหาคำนิยามที่คูปองหมดอายุและงานจบแล้ว เพื่อลบคำนิยามและคูปองที่ไม่เคยถูกผูกกับใบเสร็จออกจากฐานข้อมูล" 
                               FontSize="13" 
                               Foreground="#E0E7FF"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab Selection Buttons -->
        <Border Grid.Row="2" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" Padding="16,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="EligibleTabButton"
                            Content="คำนิยามที่พร้อมลบ"
                            Click="EligibleTabButton_Click"
                            Padding="16,8"
                            CornerRadius="6"
                            FontWeight="SemiBold"/>

                    <Button x:Name="HistoryTabButton"
                            Content="ประวัติการลบ"
                            Click="HistoryTabButton_Click"
                            Padding="16,8"
                            CornerRadius="6"
                            FontWeight="SemiBold"/>
                </StackPanel>

                <Button x:Name="RefreshCurrentTabButton"
                        Grid.Column="2"
                        Click="RefreshCurrentTabButton_Click"
                        Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Refresh"/>
                        <TextBlock Text="รีเฟรช"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="3" Margin="16,0,16,16">

            <!-- ===================== VIEW 1: ELIGIBLE DEFINITIONS ===================== -->
            <Grid x:Name="EligibleDefinitionsView" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Filters -->
                    <RowDefinition Height="Auto"/> <!-- Summary Bar -->
                    <RowDefinition Height="*"/>    <!-- List -->
                </Grid.RowDefinitions>

                <!-- Filters -->
                <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" 
                        CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Branch Filter -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="สาขา:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ComboBox x:Name="BranchFilterComboBox" Width="180" SelectionChanged="BranchFilterComboBox_SelectionChanged">
                                <ComboBoxItem Content="ทุกสาขา" Tag="0"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Search Box -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="ค้นหา:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBox x:Name="SearchTextBox" Width="240" PlaceholderText="ค้นหาด้วยรหัส หรือชื่อคูปอง..." 
                                     TextChanged="SearchTextBox_TextChanged"/>
                        </StackPanel>

                        <Button Grid.Column="2" Content="ล้างค้นหา" Click="ClearSearchButton_Click" Margin="8,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Summary & Batch Selection Bar -->
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Select All CheckBox -->
                        <CheckBox x:Name="SelectAllCheckBox" 
                                  Content="เลือกทั้งหมด" 
                                  Checked="SelectAllCheckBox_Checked" 
                                  Unchecked="SelectAllCheckBox_Unchecked" 
                                  VerticalAlignment="Center"
                                  FontWeight="SemiBold"/>

                        <!-- Summary text in the middle -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,16,0">
                            <TextBlock x:Name="SummaryCountTextBlock" 
                                       Text="กำลังโหลดข้อมูล..." 
                                       FontWeight="SemiBold" 
                                       Foreground="{ThemeResource SystemAccentColor}"/>
                            <TextBlock Text="* ทุกรายการผ่านการตรวจสอบแล้วว่าหมดอายุ, งานจบแล้ว, และไม่มีคูปองใดผูกกับใบเสร็จ" 
                                       FontSize="11" 
                                       Foreground="#64748B" 
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Delete Selected Button -->
                        <Button x:Name="DeleteSelectedButton"
                                Grid.Column="2"
                                Style="{StaticResource DestructiveButtonStyle}"
                                Click="DeleteSelectedButton_Click"
                                IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="Delete" Foreground="White"/>
                                <TextBlock x:Name="DeleteSelectedButtonText" Text="ลบรายการที่เลือก (0)"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Loading Ring -->
                <ProgressRing x:Name="LoadingRing" Grid.Row="2" IsActive="False" Width="40" Height="40" 
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Empty State -->
                <StackPanel x:Name="EmptyStatePanel" Grid.Row="2" Visibility="Collapsed" 
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <SymbolIcon Symbol="Accept" Foreground="#10B981"/>
                    <TextBlock Text="ไม่พบคำนิยามคูปองที่เข้าเกณฑ์การลบ" FontSize="18" FontWeight="SemiBold" 
                               Foreground="#475569" HorizontalAlignment="Center"/>
                    <TextBlock Text="ไม่มีคำนิยามคูปองที่หมดอายุและไม่เคยถูกใช้งานในขณะนี้" FontSize="13" 
                               Foreground="#64748B" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Eligible List -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ListView x:Name="EligibleListView" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="services:CleanupCouponDefinitionItem">
                                <Border Style="{StaticResource CardBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Row Checkbox -->
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{x:Bind IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Checked="ItemCheckBox_CheckedChanged"
                                                  Unchecked="ItemCheckBox_CheckedChanged"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,12,0"/>

                                        <!-- Details -->
                                        <StackPanel Grid.Column="1" Spacing="8">
                                            <!-- Code, Name, Branch, and Status Badge -->
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Code}" FontWeight="Bold" FontSize="18" Foreground="{ThemeResource SystemAccentColor}"/>
                                                <TextBlock Text="{x:Bind Name}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                
                                                <!-- Branch Badge -->
                                                <Border Background="#E0E7FF" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind BranchName}" FontSize="12" Foreground="#3730A3" FontWeight="Medium"/>
                                                </Border>

                                                <!-- Status Badge (Created vs Not Created) -->
                                                <Border CornerRadius="4" Padding="8,2" VerticalAlignment="Center"
                                                        Background="{x:Bind StatusBadgeBackground}"
                                                        BorderBrush="{x:Bind StatusBadgeBorder}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{x:Bind StatusBadgeText}" 
                                                               FontSize="12" 
                                                               FontWeight="SemiBold"
                                                               Foreground="{x:Bind StatusBadgeForeground}"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Metadata details -->
                                            <Grid ColumnSpacing="24" RowSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Price -->
                                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="ราคา:" Foreground="#64748B" FontSize="13"/>
                                                    <TextBlock Text="{x:Bind PriceDisplay}" FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock Text="บาท" Foreground="#64748B" FontSize="13"/>
                                                </StackPanel>

                                                <!-- Valid Dates -->
                                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="ช่วงเวลาใช้งาน:" Foreground="#64748B" FontSize="13"/>
                                                    <TextBlock Text="{x:Bind ValidFromDisplay}" FontSize="13"/>
                                                    <TextBlock Text="ถึง" Foreground="#64748B" FontSize="13"/>
                                                    <TextBlock Text="{x:Bind ValidToDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="#DC2626"/>
                                                    <TextBlock Text="(หมดอายุแล้ว)" FontSize="12" Foreground="#DC2626"/>
                                                </StackPanel>

                                                <!-- Sale Event -->
                                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="งานขาย:" Foreground="#64748B" FontSize="13"/>
                                                    <TextBlock Text="{x:Bind SaleEventName}" FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock Text="(งานจบแล้ว)" FontSize="12" Foreground="#64748B"/>
                                                </StackPanel>

                                                <!-- Created info -->
                                                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="สร้างโดย:" Foreground="#64748B" FontSize="13"/>
                                                    <TextBlock Text="{x:Bind CreatedBy}" FontSize="13"/>
                                                    <TextBlock Text="เมื่อ:" Foreground="#64748B" FontSize="13" Margin="8,0,0,0"/>
                                                    <TextBlock Text="{x:Bind CreatedAtDisplay}" FontSize="13"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Delete Action Button -->
                                        <Button Grid.Column="2"
                                                Style="{StaticResource DestructiveButtonStyle}"
                                                VerticalAlignment="Center"
                                                Margin="16,0,0,0"
                                                Tag="{x:Bind Id}"
                                                Click="DeleteButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <SymbolIcon Symbol="Delete" Foreground="White"/>
                                                <TextBlock Text="ลบข้อมูล"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </ScrollViewer>
            </Grid>

            <!-- ===================== VIEW 2: DELETION HISTORY ===================== -->
            <Grid x:Name="HistoryView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- History Summary -->
                    <RowDefinition Height="*"/>    <!-- History List -->
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#EEF2F6" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                    <TextBlock x:Name="HistoryCountTextBlock" 
                               Text="ประวัติการลบทั้งหมด" 
                               FontWeight="SemiBold" 
                               Foreground="#334155" 
                               VerticalAlignment="Center"/>
                </Border>

                <!-- History Loading Ring -->
                <ProgressRing x:Name="HistoryLoadingRing" Grid.Row="1" IsActive="False" Width="40" Height="40" 
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- History Empty State -->
                <StackPanel x:Name="HistoryEmptyStatePanel" Grid.Row="1" Visibility="Collapsed" 
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <SymbolIcon Symbol="Document" Foreground="#94A3B8"/>
                    <TextBlock Text="ยังไม่มีประวัติการลบคำนิยามคูปอง" FontSize="16" FontWeight="SemiBold" 
                               Foreground="#475569" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- History List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ListView x:Name="HistoryListView" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CouponDefinitionDeletionHistory">
                                <Border Style="{StaticResource CardBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind CouponCode}" FontWeight="Bold" FontSize="16"/>
                                                <TextBlock Text="{x:Bind CouponName}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Border Background="#E2E8F0" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{x:Bind BranchName}" FontSize="12" Foreground="#334155"/>
                                                </Border>
                                                <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{x:Bind SaleEventName}" FontSize="12" Foreground="#475569"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="16">
                                                <TextBlock Text="{x:Bind DeletionReason}" FontSize="13" Foreground="#64748B"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Right side stats: Coupons deleted & Deleted by -->
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
                                            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="คูปองที่สร้างไว้:" FontSize="12" Foreground="#991B1B"/>
                                                    <TextBlock Text="{x:Bind TotalCouponsCreatedDisplay}" FontSize="12" FontWeight="Bold" Foreground="#991B1B"/>
                                                    <TextBlock Text="ใบ" FontSize="12" Foreground="#991B1B"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="#64748B">
                                                <Run Text="ลบโดย: "/>
                                                <Run Text="{x:Bind DeletedBy}" FontWeight="SemiBold"/>
                                                <Run Text=" เมื่อ: "/>
                                                <Run Text="{x:Bind DeletedAtDisplay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </ScrollViewer>
            </Grid>

        </Grid>
    </Grid>
</Page>
